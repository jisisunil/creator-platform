# Copy to .env for local development. Never commit .env (SR-10).
# Every variable is validated at startup by src/config/env.ts.

# Runtime environment name: development | test | staging | production
APP_ENV=development

# Public base URL of the web app, used in emails and OAuth redirects.
APP_URL=http://localhost:3000

# PostgreSQL connection (docker compose service). Region in production: Mumbai/Hyderabad (PR-12).
DATABASE_URL=postgresql://creator:creator_dev_password@localhost:5432/creator_platform

# Direct (non-pooled) connection for migrations and the job queue. Optional; defaults to
# DATABASE_URL. Set it when DATABASE_URL points at PgBouncer (ADR-005).
DATABASE_DIRECT_URL=

# Connection pool per process (ADR-005). Sum over all instances must fit the server.
DATABASE_POOL_MAX=10
# Queries running longer than this are cancelled.
DATABASE_STATEMENT_TIMEOUT_MS=15000
# How long to wait for a free connection.
DATABASE_CONNECT_TIMEOUT_MS=5000

# Database used by integration tests (created by docker/postgres/init).
DATABASE_URL_TEST=postgresql://creator:creator_dev_password@localhost:5432/creator_platform_test

# Log verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Sentry error reporting (optional). Leave empty to disable. Events are scrubbed of personal data.
SENTRY_DSN=
# Same DSN for the browser (optional).
NEXT_PUBLIC_SENTRY_DSN=
# Only for CI release builds that upload source maps (optional).
SENTRY_AUTH_TOKEN=

# --- Accounts and security (phase b) ---

# Signs the short-lived pending Google sign-up cookie. 32+ random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# 32 random bytes, base64. Encrypts TOTP secrets and social tokens at rest (SR-6).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Google sign-in (optional). Set both or neither. Callback: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Outgoing email. Local: Mailpit from docker compose (web UI at http://localhost:8025).
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Creator Platform <no-reply@example.invalid>

# Cloudflare Turnstile CAPTCHA. Optional in development, required in staging/production.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Breached-password check: hibp (online, k-anonymity) or offline (bundled list only).
BREACHED_PASSWORD_CHECK=hibp

# Number of trusted reverse proxies in front of the app; 0 ignores X-Forwarded-For.
TRUSTED_PROXY_HOPS=0

# --- Creators and social accounts (phase c) ---

# mock: built-in fake YouTube/Instagram (no keys needed). live: official APIs (required in
# staging/production). Live YouTube uses AUTH_GOOGLE_ID/SECRET for the ownership login.
SOCIAL_PROVIDER_MODE=mock
# YouTube Data API v3 key, for public channel statistics.
YOUTUBE_API_KEY=
# Instagram API with Instagram Login app credentials (needs Meta app review).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Where uploaded files are kept in development (outside the web root; git-ignored).
FILE_STORAGE_DIR=./storage
# clamav (required in staging/production) or disabled (development only).
MALWARE_SCANNER=disabled
# clamd address when MALWARE_SCANNER=clamav (docker compose --profile scan up).
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
