# Closed pilot settings (docs/runbooks/laptop-pilot.md). start.ps1 copies this to pilot.env
# (git-ignored, never share it) and generates the secrets at the bottom. Replace every
# REPLACE_ME, then run start.ps1 again.

# --- Email, sent from your own Gmail (free, up to 500 a day) ---
# Needs 2-Step Verification on your Google account, then an app password:
# myaccount.google.com -> Security -> 2-Step Verification -> App passwords.
# Write the @ of your address as %40, and the 16-letter app password without spaces.
SMTP_URL=smtps://REPLACE_ME%40gmail.com:REPLACE_ME@smtp.gmail.com:465
# Gmail only sends from your own address.
EMAIL_FROM=Creator Pilot <REPLACE_ME@gmail.com>
# Shown to brands who ask about plans; monitoring alerts go to ALERT_EMAIL.
SALES_EMAIL=REPLACE_ME@gmail.com
ALERT_EMAIL=REPLACE_ME@gmail.com

# --- Who may sign up: everyone in the pilot, comma-separated (creators and brands) ---
# Your own admin account is created separately (create-admin, see the runbook).
SIGNUP_ALLOWLIST=REPLACE_ME@gmail.com

LOG_LEVEL=info

# --- Generated by start.ps1; keep them secret and back them up with the data ---
# Losing TOKEN_ENCRYPTION_KEY makes two-factor secrets unreadable; losing POSTGRES_PASSWORD
# locks you out of the database.
AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
