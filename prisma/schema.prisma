// Database schema. Requirement IDs refer to docs/REQUIREMENTS.md.
// Rules: every table has id/createdAt/updatedAt; index every foreign key and
// every column used in search filters or sorts (CLAUDE.md §9).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Platform configuration (International expansion: new country = new rows)
// ---------------------------------------------------------------------------

enum NumberFormat {
  INDIAN // 1,00,000 (lakh/crore)
  INTERNATIONAL // 100,000
}

enum SocialPlatform {
  YOUTUBE
  INSTAGRAM
}

model CountrySettings {
  id                   String           @id @default(cuid())
  code                 String           @unique // ISO 3166-1 alpha-2
  currencyCode         String // ISO 4217
  numberFormat         NumberFormat
  defaultLocale        String
  supportedLocales     String[]
  defaultTimezone      String // IANA zone
  enabledPlatforms     SocialPlatform[]
  dataRegion           String
  privacyNoticeVersion String
  isEnabled            Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  categories     Category[]
  plans          Plan[]
  users          User[]
  creators       CreatorProfile[]
  brands         Brand[]
  privacyNotices PrivacyNotice[]
}

model Language {
  id         String   @id @default(cuid())
  code       String   @unique // ISO 639-1 / 639-3
  nativeName String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  creators CreatorLanguage[]
}

/// Content categories, per country. Display names come from i18n (categories.<slug>).
model Category {
  id          String            @id @default(cuid())
  countryCode String
  slug        String
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  country     CountrySettings   @relation(fields: [countryCode], references: [code])
  creators    CreatorCategory[]

  @@unique([countryCode, slug])
  @@index([countryCode])
}

enum PlanCode {
  FREE_BETA
  TRIAL
  PAY_AS_YOU_GO
  STARTER
  PRO
  AGENCY
}

enum BillingPeriod {
  NONE
  MONTHLY
}

/// Brand plans and limits (FR-11.1). Prices per country in minor units.
model Plan {
  id                       String          @id @default(cuid())
  code                     PlanCode
  countryCode              String
  priceMinor               Int
  currencyCode             String
  billingPeriod            BillingPeriod
  contactRequestsPerPeriod Int
  seatLimit                Int
  shortlistLimit           Int
  profileViewsPerHour      Int
  trialDays                Int?
  canSaveSearch            Boolean
  canCompare               Boolean
  canCampaignReports       Boolean
  canCsvExport             Boolean
  /// Pay-as-you-go: contact requests come from bought credit packs, not a monthly allowance.
  usesCreditPacks          Boolean         @default(false)
  isActive                 Boolean         @default(true)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  country                  CountrySettings @relation(fields: [countryCode], references: [code])
  brands                   Brand[]

  @@unique([code, countryCode])
  @@index([countryCode])
}

/// Admin-editable platform switches, e.g. isFreeBetaActive.
model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Accounts, sessions and security (FR-1, UC-A, SR-1..5, SR-13)
// Personal data: User, AuthAccount, Session, OneTimeToken, ConsentRecord,
// AuditEvent (IP), EmailOutbox, BrandMember, BrandInvite. All are covered by the
// retention job; export and deletion arrive in phase g.
// ---------------------------------------------------------------------------

enum UserRole {
  CREATOR
  BRAND
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION // signed up, email not verified yet (deleted after 7 days)
  ACTIVE
  SUSPENDED
  DELETION_PENDING // PRV-4: signed out and hidden at once; anonymised after 30 days
  ANONYMISED // PRV-4: personal data removed; the row stays so others' copies say "Deleted user"
}

model User {
  id                  String     @id @default(cuid())
  /// Always stored lower-cased and trimmed.
  email               String     @unique
  /// The mailbox behind the email (Gmail dots and "+tags" removed), to spot repeated
  /// sign-ups for trials (UC-B1). Derived from the email; never shown.
  canonicalEmail      String?
  emailVerifiedAt     DateTime?
  /// Argon2id hash; null for Google-only accounts.
  passwordHash        String?
  name                String
  role                UserRole
  status              UserStatus @default(PENDING_VERIFICATION)
  countryCode         String
  locale              String
  failedLoginCount    Int        @default(0)
  lockedUntil         DateTime?
  /// TOTP secret encrypted with the token cipher (SR-4, admins).
  totpSecretEncrypted String?
  totpEnabledAt       DateTime?
  lastLoginAt         DateTime?
  /// PR-9: when we warned that the account will be deleted for inactivity; cleared on sign-in.
  inactivityWarnedAt  DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  country                  CountrySettings           @relation(fields: [countryCode], references: [code])
  authAccounts             AuthAccount[]
  sessions                 Session[]
  oneTimeTokens            OneTimeToken[]
  consents                 ConsentRecord[]
  brandMember              BrandMember?
  creatorProfile           CreatorProfile?
  pendingSocialConnections PendingSocialConnection[]
  ownershipDisputes        OwnershipDispute[]
  shortlists               Shortlist[]
  savedSearches            SavedSearch[]
  sentInvites              BrandInvite[]
  emailOutbox              EmailOutbox[]
  sentRequests             CollabRequest[]
  sentMessages             Message[]
  dealEvents               DealEvent[]
  ratingsGiven             Rating[]
  chatAccessGrants         ChatAccessGrant[]
  dataRequests             DataRequest[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  reports                  Report[]

  @@index([status, createdAt])
  @@index([role])
  @@index([countryCode])
  @@index([canonicalEmail])
  @@index([status, lastLoginAt])
}

/// External sign-in identities (Google). Only ids are stored, no provider tokens.
model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Server-side sessions (SR-2). Only a SHA-256 hash of the cookie token is stored.
model Session {
  id                  String    @id @default(cuid())
  tokenHash           String    @unique
  userId              String
  expiresAt           DateTime
  lastSeenAt          DateTime
  ipAddress           String?
  userAgent           String?
  /// Hash of the user agent, used to spot sign-ins from a new device (SEC-9).
  deviceHash          String
  /// Set when an admin has entered a TOTP code in this session (SR-4).
  twoFactorVerifiedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum OneTimeTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  CHANGE_EMAIL
}

/// Single-use emailed links. Only a hash of the token is stored.
model OneTimeToken {
  id        String              @id @default(cuid())
  purpose   OneTimeTokenPurpose
  tokenHash String              @unique
  userId    String
  /// Address the link was sent to (the new address for CHANGE_EMAIL).
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// Published privacy notice versions per country (PR-1, PR-3). Text lives in i18n.
model PrivacyNotice {
  id               String          @id @default(cuid())
  countryCode      String
  version          String
  publishedAt      DateTime
  /// True when purposes changed, so users must agree again (PRV-8).
  isMaterialChange Boolean
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  country          CountrySettings @relation(fields: [countryCode], references: [code])

  @@unique([countryCode, version])
}

enum ConsentKind {
  AGE_CONFIRMATION
  PRIVACY_NOTICE
  MARKETING
}

/// Append-only consent history (PR-2, PR-3, PR-4). Rows are never updated.
model ConsentRecord {
  id            String      @id @default(cuid())
  userId        String
  kind          ConsentKind
  isGranted     Boolean
  noticeVersion String
  ipAddress     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

/// Fixed-window counters for rate limiting (SR-3, SR-11). Keys are hashed.
model RateLimitCounter {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([windowStart])
}

enum AuditCategory {
  SECURITY
  ADMIN
  DATA
}

/// Append-only audit and security log (SR-13). No passwords, tokens or chat content;
/// emails are masked. Kept for one year.
model AuditEvent {
  id            String        @id @default(cuid())
  category      AuditCategory
  action        String
  actorUserId   String?
  subjectUserId String?
  ipAddress     String?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([category, createdAt])
  @@index([action, createdAt])
  @@index([actorUserId])
  @@index([subjectUserId])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

/// Transactional outbox: emails are written in the same transaction as the change
/// that causes them, then sent by the worker.
model EmailOutbox {
  id        String      @id @default(cuid())
  userId    String?
  toAddress String
  template  String
  locale    String
  /// Template variables; cleared once sent because they may hold one-time links.
  payload   Json?
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Brands and teams (UC-A6)
// ---------------------------------------------------------------------------

enum BrandMemberRole {
  OWNER
  MEMBER
}

model Brand {
  id                      String          @id @default(cuid())
  name                    String
  industry                String
  website                 String?
  countryCode             String
  /// Company email domain (null for public providers); used for one trial per brand (UC-B1).
  emailDomain             String?
  planId                  String
  planStartedAt           DateTime
  trialEndsAt             DateTime?
  /// UC-B1: set when this brand's free trial started; one trial per company.
  hasHadTrial             Boolean         @default(false)
  /// Trial reminder emails already sent (FR-12.1).
  trialEndingNoticeSentAt DateTime?
  trialEndedNoticeSentAt  DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  country                 CountrySettings @relation(fields: [countryCode], references: [code])
  plan                    Plan            @relation(fields: [planId], references: [id])
  members                 BrandMember[]
  invites                 BrandInvite[]
  shortlists              Shortlist[]
  savedSearches           SavedSearch[]
  profileViews            ProfileView[]
  creditPacks             CreditPack[]
  campaigns               Campaign[]
  requests                CollabRequest[]
  blocks                  Block[]
  chatThreads             ChatThread[]
  deals                   Deal[]

  @@index([countryCode])
  @@index([planId])
  @@index([emailDomain, hasHadTrial])
  @@index([trialEndsAt])
}

model BrandMember {
  id        String          @id @default(cuid())
  brandId   String
  /// One brand per account.
  userId    String          @unique
  role      BrandMemberRole
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  brand     Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

model BrandInvite {
  id              String    @id @default(cuid())
  brandId         String
  email           String
  tokenHash       String    @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  brand           Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  invitedBy       User      @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([email])
  @@index([invitedByUserId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Creators, social accounts, stats and score (FR-2, FR-3, FR-4, UC-C)
// Personal data: CreatorProfile, RateCardItem, PortfolioItem, SocialAccount (encrypted
// tokens), PendingSocialConnection, OwnershipDispute, CreatorEmbedding (source text).
// StatsSnapshot and AudienceSegment hold public or aggregate data only.
// ---------------------------------------------------------------------------

enum CreatorTier {
  NANO // < 10k
  MICRO // 10k–100k
  MID // 100k–500k
  MACRO // 500k–1M
  MEGA // 1M+
}

model CreatorProfile {
  id                     String       @id @default(cuid())
  userId                 String       @unique
  /// Public profile URL segment (FR-2.4).
  slug                   String       @unique
  displayName            String
  bio                    String       @default("")
  /// Storage key of the profile photo (served through signed URLs, SR-9).
  photoKey               String?
  city                   String       @default("")
  /// State/UT code from config/regions.ts.
  stateCode              String       @default("")
  countryCode            String
  isOpenToCollaborations Boolean      @default(true)
  // Denormalised for search and sorting (FR-5); recomputed after every refresh.
  isSearchable           Boolean      @default(false)
  isVerified             Boolean      @default(false)
  tier                   CreatorTier?
  totalFollowers         Int          @default(0)
  /// Engagement rate in basis points (1% = 100) to keep integers.
  engagementRateBp       Int          @default(0)
  currentScore           Int?
  scoreUpdatedAt         DateTime?
  lastRefreshedAt        DateTime?
  /// Follower growth over 90 days in basis points, for the "recent growth" sort (FR-5.2).
  growth90dBp            Int?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  country           CountrySettings    @relation(fields: [countryCode], references: [code])
  languages         CreatorLanguage[]
  categories        CreatorCategory[]
  rateCard          RateCardItem[]
  portfolio         PortfolioItem[]
  socialAccounts    SocialAccount[]
  scores            ScoreResult[]
  authenticityFlags AuthenticityFlag[]
  embeddings        CreatorEmbedding[]
  shortlistItems    ShortlistItem[]
  profileViews      ProfileView[]
  requests          CollabRequest[]
  blocks            Block[]
  chatThreads       ChatThread[]
  deals             Deal[]

  @@index([countryCode, stateCode, city])
  @@index([isSearchable, currentScore])
  @@index([tier])
  @@index([totalFollowers])
  @@index([engagementRateBp])
  @@index([isVerified])
  @@index([isOpenToCollaborations])
  // Sort paths for search (FR-5.2, ADR-005): filter on isSearchable, order by the metric.
  @@index([isSearchable, engagementRateBp])
  @@index([isSearchable, totalFollowers])
  @@index([isSearchable, growth90dBp])
  // Text search on name and bio (FR-5.2); pg_trgm is enabled in the migration.
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "CreatorProfile_displayName_trgm_idx")
  @@index([bio(ops: raw("gin_trgm_ops"))], type: Gin, map: "CreatorProfile_bio_trgm_idx")
}

model CreatorLanguage {
  id           String         @id @default(cuid())
  creatorId    String
  languageCode String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  creator      CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  language     Language       @relation(fields: [languageCode], references: [code])

  @@unique([creatorId, languageCode])
  @@index([languageCode])
}

model CreatorCategory {
  id         String         @id @default(cuid())
  creatorId  String
  categoryId String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  creator    CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  category   Category       @relation(fields: [categoryId], references: [id])

  @@unique([creatorId, categoryId])
  @@index([categoryId])
}

enum Deliverable {
  REEL
  STORY
  VIDEO
  POST
}

/// Optional prices per deliverable (FR-2.1), in minor units of the currency.
model RateCardItem {
  id          String         @id @default(cuid())
  creatorId   String
  deliverable Deliverable
  amountMinor Int
  currency    String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  creator     CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, deliverable])
}

/// Past brand collaborations (FR-2.2).
model PortfolioItem {
  id             String         @id @default(cuid())
  creatorId      String
  url            String
  brandName      String
  collaboratedOn DateTime       @db.Date
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  creator        CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
}

enum SocialAccountStatus {
  ACTIVE
  TOKEN_REVOKED // needs reconnecting
  PRIVATE // account made private
  DELETED // account deleted on the platform
}

/// A connected YouTube channel or Instagram account (FR-3). One claim per platform account.
model SocialAccount {
  id                    String              @id @default(cuid())
  creatorId             String
  platform              SocialPlatform
  externalId            String
  handle                String
  displayName           String
  /// FR-3.3: true only when ownership was proved through the platform's official login.
  isVerified            Boolean             @default(false)
  verifiedAt            DateTime?
  /// Tokens encrypted with the token cipher (SR-6); null for public, unverified links.
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  status                SocialAccountStatus @default(ACTIVE)
  /// YouTube can hide subscriber counts (UC-C2).
  isFollowerCountHidden Boolean             @default(false)
  lastRefreshedAt       DateTime?
  lastRefreshError      String?
  nextRefreshAt         DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  creator               CreatorProfile      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  snapshots             StatsSnapshot[]
  audience              AudienceSegment[]
  disputes              OwnershipDispute[]
  dealPosts             DealPost[]

  @@unique([platform, externalId])
  @@index([creatorId])
  @@index([status, nextRefreshAt])
}

/// One day of public statistics for an account (FR-3.4); feeds growth charts and the score.
model StatsSnapshot {
  id              String        @id @default(cuid())
  socialAccountId String
  capturedOn      DateTime      @db.Date
  followers       Int
  mediaCount      Int
  /// Totals over posts published in the 30 days before capture.
  posts30d        Int
  views30d        Int?
  likes30d        Int
  comments30d     Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, capturedOn])
}

enum AudienceDimension {
  AGE
  GENDER
  CITY
}

/// Aggregate audience share (PR-8), from Instagram insights. Deleted on disconnect (PRV-7).
model AudienceSegment {
  id              String            @id @default(cuid())
  socialAccountId String
  dimension       AudienceDimension
  bucket          String
  /// Share of the audience in thousandths (1000 = 100%).
  sharePermille   Int
  capturedOn      DateTime          @db.Date
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  socialAccount   SocialAccount     @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, dimension, bucket])
}

/// A computed content score with its breakdown and weights version (FR-4.3).
model ScoreResult {
  id             String         @id @default(cuid())
  creatorId      String
  score          Int
  /// Component scores 0–100 and the inputs used, for the transparent breakdown (FR-4.2).
  components     Json
  weightsVersion String
  computedAt     DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  creator        CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, computedAt])
}

enum AuthenticityFlagType {
  FOLLOWER_SPIKE
  LOW_VIEWS_RATIO
  ABNORMAL_ENGAGEMENT
}

enum AuthenticityFlagStatus {
  OPEN
  CLEARED
  SUSPICIOUS
}

/// FR-4.5: signals that lower the score and go to the admin queue (UC-M2).
model AuthenticityFlag {
  id               String                 @id @default(cuid())
  creatorId        String
  type             AuthenticityFlagType
  details          Json
  status           AuthenticityFlagStatus @default(OPEN)
  reviewedByUserId String?
  reviewedAt       DateTime?
  /// UC-M2: the creator's explanation when they appeal a "suspicious" decision.
  appealText       String?
  appealedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  creator          CreatorProfile         @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([creatorId, type])
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

/// UC-C2/UC-C3 → UC-M3: someone tried to connect an account another creator has claimed.
model OwnershipDispute {
  id               String        @id @default(cuid())
  socialAccountId  String
  claimantUserId   String
  /// Whether the claimant proved ownership through the official login.
  isClaimVerified  Boolean
  status           DisputeStatus @default(OPEN)
  resolution       String?
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  socialAccount    SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  claimant         User          @relation(fields: [claimantUserId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([socialAccountId])
  @@index([claimantUserId])
}

/// Accounts returned by an OAuth login, waiting for the creator to pick one (UC-C2:
/// several channels on one Google account). Tokens encrypted; expires in 15 minutes.
model PendingSocialConnection {
  id                    String         @id @default(cuid())
  userId                String
  platform              SocialPlatform
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  /// [{ externalId, handle, displayName }]
  accounts              Json
  expiresAt             DateTime
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Reserved for future semantic search. Empty: no AI features use it, and no data is sent to
/// any AI service. The vector column and its HNSW index are created in raw SQL.
model CreatorEmbedding {
  id         String                       @id @default(cuid())
  creatorId  String
  model      String
  version    String
  embedding  Unsupported("vector(1024)")?
  sourceText String
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt
  creator    CreatorProfile               @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, model, version])
}

// ---------------------------------------------------------------------------
// Brand discovery: shortlists, saved searches, profile views (FR-5, FR-6, UC-D)
// ---------------------------------------------------------------------------

/**
 * FR-6.1: a brand's named list of creators. Private to its maker until shared with the team.
 */
model Shortlist {
  id               String          @id @default(cuid())
  brandId          String
  createdByUserId  String
  name             String
  isSharedWithTeam Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  brand            Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy        User            @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  items            ShortlistItem[]

  @@index([brandId])
  @@index([createdByUserId])
}

model ShortlistItem {
  id          String         @id @default(cuid())
  shortlistId String
  creatorId   String
  /// The brand's private note about this creator (FR-6.1).
  note        String         @default("")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  shortlist   Shortlist      @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  creator     CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([shortlistId, creatorId])
  @@index([creatorId])
}

/**
 * FR-5.4 / UC-D5: search filters saved by a brand user to rerun later.
 */
model SavedSearch {
  id              String   @id @default(cuid())
  brandId         String
  createdByUserId String
  name            String
  /// Validated search filters; filtersVersion says which schema wrote them.
  filters         Json
  filtersVersion  Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  brand           Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy       User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([createdByUserId])
}

/**
 * A brand viewing a creator profile: per-hour view limits (SEC-3) and creator analytics (UC-C7).
 */
model ProfileView {
  id            String         @id @default(cuid())
  creatorId     String
  viewerBrandId String
  viewedAt      DateTime
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  creator       CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  viewerBrand   Brand          @relation(fields: [viewerBrandId], references: [id], onDelete: Cascade)

  @@index([viewerBrandId, viewedAt])
  @@index([creatorId, viewedAt])
}

// ---------------------------------------------------------------------------
// Collaboration (phase e): requests, campaigns, blocks
// ---------------------------------------------------------------------------

/// What the brand may do with the content (FR-7.1).
enum UsageRights {
  CREATOR_CHANNELS_ONLY // posted on the creator's channels only
  BRAND_ORGANIC // the brand may also repost it on its own channels
  BRAND_PAID_ADS // the brand may also use it in paid ads
}

enum CollabRequestStatus {
  OPEN
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

/// Groups a brand's requests and deals (FR-9.3); created from the campaign name on a request.
model Campaign {
  id        String          @id @default(cuid())
  brandId   String
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  brand     Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  requests  CollabRequest[]
  deals     Deal[]

  @@unique([brandId, name])
}

/// A brand's collaboration request to a creator (FR-7, UC-R1, UC-R2).
model CollabRequest {
  id            String              @id @default(cuid())
  brandId       String
  creatorId     String
  campaignId    String
  /// The team member who sent it; kept as null if they leave or delete their account.
  sentByUserId  String?
  /// The pay-as-you-go pack this request used a credit from, if any.
  creditPackId  String?
  brief         String
  /// [{ deliverable, quantity }], validated by lib/validation/request-schemas.ts.
  deliverables  Json
  /// Optional budget in minor units (paise).
  budgetMinor   Int?
  currencyCode  String
  deadline      DateTime            @db.Date
  usageRights   UsageRights
  status        CollabRequestStatus @default(OPEN)
  /// "brandId:creatorId" while OPEN and null afterwards: one open request per pair (FR-7.3).
  openPairKey   String?             @unique
  /// Bumped on every brand edit; the creator accepts the version they saw (UC-R2).
  version       Int                 @default(1)
  declineReason String?
  expiresAt     DateTime
  respondedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  brand         Brand               @relation(fields: [brandId], references: [id])
  creator       CreatorProfile      @relation(fields: [creatorId], references: [id])
  campaign      Campaign            @relation(fields: [campaignId], references: [id])
  sentBy        User?               @relation(fields: [sentByUserId], references: [id], onDelete: SetNull)
  creditPack    CreditPack?         @relation(fields: [creditPackId], references: [id], onDelete: SetNull)
  chatThread    ChatThread?
  deal          Deal?

  @@index([brandId, createdAt])
  @@index([brandId, status])
  @@index([creatorId, status, createdAt])
  @@index([status, expiresAt])
  @@index([campaignId])
  @@index([sentByUserId])
  @@index([creditPackId])
}

enum BlockSide {
  CREATOR
  BRAND
}

/// A creator blocking a brand, or a brand blocking a creator (FR-8.3, UC-R1).
model Block {
  id        String         @id @default(cuid())
  creatorId String
  brandId   String
  blockedBy BlockSide
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  brand     Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([creatorId, brandId, blockedBy])
  @@index([brandId])
}

// ---------------------------------------------------------------------------
// Chat and reports (phase e)
// ---------------------------------------------------------------------------

/// Which side of a collaboration a person acts for.
enum CollabSide {
  BRAND
  CREATOR
}

/// Contact details found in an early chat message (FR-8.2).
enum ContactFlag {
  EMAIL
  PHONE
  LINK
}

/// One chat per accepted request (FR-8.1). Read positions are per side: a brand's team
/// shares one inbox.
model ChatThread {
  id                String            @id @default(cuid())
  requestId         String            @unique
  brandId           String
  creatorId         String
  lastMessageAt     DateTime?
  brandLastReadAt   DateTime?
  creatorLastReadAt DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  request           CollabRequest     @relation(fields: [requestId], references: [id])
  brand             Brand             @relation(fields: [brandId], references: [id])
  creator           CreatorProfile    @relation(fields: [creatorId], references: [id])
  messages          Message[]
  accessGrants      ChatAccessGrant[]

  @@index([brandId, lastMessageAt])
  @@index([creatorId, lastMessageAt])
}

model Message {
  id           String        @id @default(cuid())
  threadId     String
  /// Null once the sender's account is deleted; shown as "Deleted user" (PRV-4).
  senderUserId String?
  senderSide   CollabSide
  body         String
  contactFlags ContactFlag[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  thread       ChatThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender       User?         @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  attachment   Attachment?

  @@index([threadId, createdAt])
  @@index([senderUserId])
}

/// A scanned file sent in chat (SR-9): random storage key, served only via signed URLs.
model Attachment {
  id          String   @id @default(cuid())
  messageId   String   @unique
  storageKey  String   @unique
  fileName    String
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

enum ReportTarget {
  BRAND // a brand reported by a creator
  CREATOR // a creator reported by a brand
  RATING // an unfair review (FR-10.3)
  PAYMENT // "payment not received" (UC-R5)
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// Something sent to the admin moderation queue (FR-8.3, FR-13.1); handled in phase g.
model Report {
  id              String       @id @default(cuid())
  reporterUserId  String?
  targetType      ReportTarget
  /// Brand, creator profile, rating or deal id, by targetType.
  targetId        String
  /// The chat the report is about, if any; admins open it only with a logged reason (SEC-11).
  threadId        String?
  reason          String
  status          ReportStatus @default(OPEN)
  resolution      String?
  handledByUserId String?
  handledAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  reporter        User?        @relation(fields: [reporterUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterUserId])
  @@index([targetType, targetId])
  @@index([threadId])
}

// ---------------------------------------------------------------------------
// Deals and campaign reports (phase e)
// ---------------------------------------------------------------------------

/// FR-9.1: requested → accepted → content submitted → posted → payment marked → completed.
enum DealStatus {
  ACCEPTED
  CONTENT_SUBMITTED
  POSTED
  PAYMENT_MARKED
  COMPLETED
  CANCELLED
}

/// A collaboration after the creator accepted (FR-9, UC-R4, UC-R5).
model Deal {
  id                     String         @id @default(cuid())
  requestId              String         @unique
  campaignId             String
  brandId                String
  creatorId              String
  status                 DealStatus     @default(ACCEPTED)
  /// Agreed amount in minor units (paise); starts as the request's budget.
  agreedAmountMinor      Int?
  currencyCode           String
  /// FR-9.2: share paid in advance, 0-100; the rest is the balance.
  advancePercent         Int?
  paymentDueOn           DateTime?      @db.Date
  deadline               DateTime       @db.Date
  postedAt               DateTime?
  paymentMarkedAt        DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  cancelledBySide        CollabSide?
  cancelReason           String?
  deadlineReminderSentAt DateTime?
  paymentReminderSentAt  DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  request                CollabRequest  @relation(fields: [requestId], references: [id])
  campaign               Campaign       @relation(fields: [campaignId], references: [id])
  brand                  Brand          @relation(fields: [brandId], references: [id])
  creator                CreatorProfile @relation(fields: [creatorId], references: [id])
  events                 DealEvent[]
  posts                  DealPost[]
  ratings                Rating[]

  @@index([brandId, status])
  @@index([creatorId, status])
  @@index([campaignId])
  @@index([status, deadline])
  @@index([status, postedAt])
}

enum DealEventKind {
  CREATED
  TERMS_UPDATED
  CONTENT_SUBMITTED
  POST_ADDED
  PAYMENT_MARKED
  PAYMENT_CONFIRMED
  PAYMENT_DISPUTED
  CANCELLED
  DEADLINE_REMINDER
  PAYMENT_REMINDER
}

/// The deal's history, shown to both sides (FR-9.1).
model DealEvent {
  id          String        @id @default(cuid())
  dealId      String
  kind        DealEventKind
  actorUserId String?
  actorSide   CollabSide?
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deal        Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  actor       User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([dealId, createdAt])
  @@index([actorUserId])
}

enum DealPostStatus {
  LIVE
  DELETED // gone from the platform; last stats kept (UC-R6)
  PRIVATE // made private; last stats kept (UC-R6)
}

/// A published post for a deal, with its latest public stats (FR-9.3, UC-R6).
model DealPost {
  id              String         @id @default(cuid())
  dealId          String
  socialAccountId String?
  platform        SocialPlatform
  url             String
  externalPostId  String
  views           Int?
  likes           Int            @default(0)
  comments        Int            @default(0)
  statsFetchedAt  DateTime?
  status          DealPostStatus @default(LIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deal            Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@unique([dealId, platform, externalPostId])
  @@index([socialAccountId])
  @@index([status, statsFetchedAt])
}

// ---------------------------------------------------------------------------
// Ratings (phase e)
// ---------------------------------------------------------------------------

/// FR-10: one rating per completed deal per side. A brand rates the creator; a creator
/// rates the brand. Shown once both have rated, or 14 days after completion.
model Rating {
  id            String     @id @default(cuid())
  dealId        String
  raterSide     CollabSide
  /// Null once the rater's account is deleted; the rating stays, anonymous.
  raterUserId   String?
  /// Criterion → 1-5, validated by domain/ratings.ts.
  scores        Json
  /// Mean of the scores × 10 (43 = 4.3), for averages without floats.
  averageTenths Int
  comment       String?
  visibleFrom   DateTime
  /// Hidden by an admin after a report (FR-10.3, phase g).
  isHidden      Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deal          Deal       @relation(fields: [dealId], references: [id])
  rater         User?      @relation(fields: [raterUserId], references: [id], onDelete: SetNull)

  @@unique([dealId, raterSide])
  @@index([raterUserId])
  @@index([raterSide, visibleFrom])
}

// ---------------------------------------------------------------------------
// Pay-as-you-go credit packs (phase f)
// ---------------------------------------------------------------------------

/// Contact-request credits bought as a pack, valid for 90 days (spec: Monetisation and plans).
/// Added by an admin after payment until online payments exist (FR-11.4, later).
model CreditPack {
  id            String          @id @default(cuid())
  brandId       String
  credits       Int
  creditsUsed   Int             @default(0)
  priceMinor    Int
  currencyCode  String
  expiresAt     DateTime
  addedByUserId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  brand         Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  requests      CollabRequest[]

  @@index([brandId, expiresAt])
}

// ---------------------------------------------------------------------------
// Notifications (phase f)
// ---------------------------------------------------------------------------

/// Groups of notifications a user can switch on or off per channel (FR-12.2).
enum NotificationCategory {
  REQUESTS
  MESSAGES
  DEALS
  RATINGS
  ACCOUNT
  PLAN
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

/// An in-app notification (FR-12.1). The text comes from i18n by `kind`, filled with `params`.
model Notification {
  id        String               @id @default(cuid())
  userId    String
  category  NotificationCategory
  /// Same names as the email templates, e.g. "requestReceived".
  kind      String
  params    Json
  /// Where it leads, without the locale, e.g. "/deals/abc".
  path      String
  readAt    DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([createdAt])
}

/// A user's choice to turn a category off (or back on) for a channel; no row means on.
model NotificationPreference {
  id        String               @id @default(cuid())
  userId    String
  category  NotificationCategory
  channel   NotificationChannel
  isEnabled Boolean
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, channel])
}

// ---------------------------------------------------------------------------
// Moderation (phase g)
// ---------------------------------------------------------------------------

/// SEC-11: an admin opened a chat to investigate, with a written reason. Valid for an hour.
model ChatAccessGrant {
  id          String     @id @default(cuid())
  adminUserId String
  threadId    String
  reportId    String?
  reason      String
  expiresAt   DateTime
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  admin       User       @relation(fields: [adminUserId], references: [id])
  thread      ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt])
  @@index([threadId])
}

// ---------------------------------------------------------------------------
// Privacy rights (phase g)
// ---------------------------------------------------------------------------

enum DataRequestType {
  EXPORT // PRV-2, completed at once
  DELETION // PRV-4, finalised 30 days after the request
  CORRECTION // PRV-3, for locked fields an admin must change
}

enum DataRequestStatus {
  OPEN
  COMPLETED
  REJECTED
}

/// PR-5 / UC-M4: a privacy request, tracked against its legal due date.
model DataRequest {
  id                 String            @id @default(cuid())
  userId             String
  type               DataRequestType
  status             DataRequestStatus @default(OPEN)
  /// What the user asked for (corrections); never chat content.
  details            String?
  dueAt              DateTime
  /// UC-M4: identity confirmed (automatic for requests made while signed in).
  identityVerifiedAt DateTime?
  handledByUserId    String?
  resolution         String?
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id])

  @@index([status, dueAt])
  @@index([userId, type])
}
